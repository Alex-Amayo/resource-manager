{
  "name": "@resource-manager/cli",
  "version": "1.0.0",
  "description": "CLI tool for adding Resource Manager components to your project",
  "main": "dist/index.js",
  "bin": {
    "resource-manager": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "tsx src/test-integration.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "@types/node": "^20.17.10",
    "eslint": "^9.25.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "cli",
    "components",
    "react",
    "tailwind",
    "resource-manager"
  ],
  "author": "",
  "license": "MIT"
}
