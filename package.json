{
  "name": "resource-manager-monorepo",
  "version": "1.0.0",
  "description": "Resource Manager Monorepo",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter resource-manager build",
    "storybook": "pnpm --filter resource-manager storybook",
    "storybook:build": "pnpm --filter resource-manager build-storybook",
    "registry:build": "pnpm --filter resource-manager registry:build",
    "registry:demo": "pnpm --filter registry-demo dev",
    "registry:add": "pnpm dlx shadcn@latest add http://localhost:5173/r/resource-manager.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
